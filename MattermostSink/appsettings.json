{
  "Mattermost": {
    "WebhookUrl": "",
    "Username": "username",
    "IconEmoji": ":rocket:",

    "BatchSize": 1,
    "Period": "00:00:05",
    "QueueLimit": 10000,

    "MinimumLevel": "Error",

    "RateLimitTokens": 30,
    "RateLimitPeriod": "00:00:10",
    "FormatterOptions": {
      "OutputTemplate": "{Message:lj}{NewLine}{Exception}",
      "Emojis": {
        "Verbose": "🔍",
        "Debug": "🐞",
        "Information": "ℹ️",
        "Warning": "⚠️",
        "Error": "❌",
        "Fatal": "🔥"
      },
      "LevelColors": {
        "Verbose": "#9E9E9E",
        "Debug": "#607D8B",
        "Information": "#2196F3",
        "Warning": "#FF9800",
        "Error": "#F44336",
        "Fatal": "#9C27B0"
      },
      "UseAttachments": true,
      "IncludeLevel": true,
      "IncludeTimestamp": true,
      "IncludeProperties": true,
      "IncludeException": true,
      "IncludeEmoji": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Mattermost"
      }
    ]
  }
}