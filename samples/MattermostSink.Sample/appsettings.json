{
  "Mattermost": {
    "WebhookUrl": "https://mattermost.example.com/hooks/your-webhook-id",
    "Username": "Serilog",
    "IconEmoji": ":rocket:",
    "UseBot": false,
    "MattermostUrl": "https://mattermost.example.com",
    "BotAccessToken": "your-bot-token",
    "BotChannelId": "your-channel-id",
    "BatchSize": 20,
    "Period": "00:00:05",
    "QueueLimit": 10000,
    "MinimumLevel": "Information",
    "RateLimitTokens": 30,
    "RateLimitPeriod": "00:00:10",
    "FormatterOptions": {
      "OutputTemplate": "{Message:lj}",
      "UseAttachments": true,
      "IncludeLevel": true,
      "IncludeTimestamp": true,
      "IncludeProperties": true,
      "IncludeException": true,
      "IncludeEmoji": true
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Mattermost" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
